/* Actual transport, simulated hardware. Kept out of ADS firmware scanning. */
#include "wifispi.h"
#include "imu.h"
#include "balance_control.h"
#include <assert.h>
#include <math.h>
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

static void test_pack(void)
{
    float values[]={1.0f,-2.5f,0.0f};
    uint8_t frame[VOFA_MAX_FRAME_BYTES];
    const uint8_t expected[]={0,0,0x80,0x3f,0,0,0x20,0xc0,0,0,0,0,0,0,0x80,0x7f};
    memset(frame,0xa5,sizeof(frame));
    assert(vofa_pack(frame,15,values,3)==0 && frame[0]==0xa5);
    assert(vofa_pack(NULL,sizeof(frame),values,3)==0);
    assert(vofa_pack(frame,sizeof(frame),NULL,3)==0);
    assert(vofa_pack(frame,sizeof(frame),values,0)==0);
    assert(vofa_pack(frame,sizeof(frame),values,VOFA_MAX_CHANNELS+1u)==0);
    assert(vofa_pack(frame,sizeof(frame),values,3)==16);
    assert(memcmp(frame,expected,sizeof(expected))==0 && frame[16]==0xa5);
    float maximum[VOFA_MAX_CHANNELS]={0};
    assert(vofa_pack(frame,sizeof(frame),maximum,VOFA_MAX_CHANNELS)==sizeof(frame));
}

#if QCAR_WIFI_ENABLED
#include "zf_device_wifi_spi.h"
int host_stm;
static uint32 ticks;
static unsigned irq_disabled, init_calls, connect_calls, socket_calls, disconnect_calls;
static unsigned fail_stage, fail_attempts, fail_send, fail_flush, rx_calls;
static uint8_t incoming[8192], outgoing[1600], datagrams[128][1600];
static size_t incoming_size, outgoing_size, sizes[128], packet_count;
char wifi_spi_version[12], wifi_spi_ip_addr_port[25];
volatile int32 imu_attitude_status=1, imu_accel_used=1;
volatile float imu_roll_deg=12, imu_pitch_deg=-4, imu_yaw_deg=30;
volatile float imu_accel_g[3]={0,0,1}, imu_gyro_dps[3]={1,2,3};
volatile float imu_accel_norm_g=1.0f, imu_calibration_percent=100, imu_gyro_bias_z_dps;
volatile float imu_sample_dt_ms=5, imu_solve_us=21, imu_solve_max_us=35;
volatile float imu_ekf_nis=0.25f, imu_ekf_bias_xy_dps[2]={0.1f,-0.2f};
volatile uint32 imu_sample_sequence=1234;
volatile uint32 imu_spi_timeouts,imu_not_ready_samples,imu_last_status_reg,imu_bad_bursts;
volatile uint8 rate_only_test;
volatile uint8 pwm_debug_enabled;
volatile float pwm_debug_fly_left,pwm_debug_fly_right,pwm_debug_ground;
volatile int32 control_fault_reason,control_fault_imu_status;
volatile uint32 control_fault_seq;
volatile float control_fault_dt_ms,control_startup_scale=1;
uint32 control_startup_ramp_ms=1000;
volatile float imu_gyro_z_integral_deg=12.5f;
const uint8 imu_attitude_method=3;
volatile uint8 roll_rate_test_enabled=1,ground_rate_test_enabled,dual_balance_enabled;
volatile float dual_angle[2],dual_target[2],dual_angle_error[2],dual_rate[2],dual_target_rate[2],dual_rate_error[2],dual_pwm[2];
float ground_angle_kp=0,ground_angle_rate_limit=10;
float ground_rate_test_kp=25,ground_rate_test_limit=1000,ground_rate_test_sign=1;
int16 costrained_wheel_speed;
volatile uint32 roll_rate_test_sequence=99;
volatile int32 roll_rate_test_state=2;
volatile float roll_rate_test_actual=-12.5f, roll_rate_test_error=12.5f, roll_rate_test_pwm=250;
volatile float pitch_balance_target_rate=0, pitch_balance_error=0;
volatile float pitch_balance_actual_angle, pitch_balance_target_angle;
float pitch_balance_kp=0.5f, pitch_balance_rate_limit=20;
float roll_rate_test_kp=20, roll_rate_test_sign=1, roll_rate_test_limit=1000;
int16 costrained_flywheel_speed_left=250, costrained_flywheel_speed_right=250;
small_device_value_struct motor_value;
volatile float small_driver_test_left,small_driver_test_right;
volatile uint32 small_driver_speed_frames=123,small_driver_feedback_age_ms=12;
volatile uint8 small_driver_feedback_fresh=1;
int16_t real_speed=88;
Mono_params mono_params;
float cascade_vel_out, cascade_vel_out_p, cascade_vel_out_y;
float cascade_angle_out, cascade_angle_out_p, cascade_angle_out_y;
float cascade_angle_vel_out, cascade_angle_vel_out_p, cascade_angle_vel_out_y;
uint32 IfxStm_getLower(int *stm) { assert(stm==&host_stm); return ticks; }
float IfxStm_getFrequency(int *stm) { assert(stm==&host_stm); return 100000000.0f; }
uint32 interrupt_global_disable(void) { assert(!irq_disabled); irq_disabled=1; return 7; }
void interrupt_global_enable(uint32 mask) { assert(irq_disabled && mask==7); irq_disabled=0; }
void system_delay_ms(uint32 ms) { assert(!irq_disabled); ticks+=100000u*ms; }
static void (*active_wait_callback)(void);
void wifi_spi_set_wait_callback(void (*callback)(void)) { active_wait_callback=callback; }
void wifi_spi_cancel_wait(void) {}
uint8 wifi_spi_init(char *ssid,char *password) {
    assert(!irq_disabled && !ssid && !password); ++init_calls;
    strcpy(wifi_spi_version,fail_stage==4?"V1.0":"V2.0");
    if(fail_attempts) { --fail_attempts; return 1; }
    return fail_stage==1;
}
uint8 wifi_spi_wifi_connect(char *ssid,char *password) {
    assert(!irq_disabled && ssid && password); ++connect_calls; return fail_stage==2;
}
uint8 wifi_spi_socket_connect(char *type,char *ip,char *port,char *local) {
    assert(!irq_disabled && !strcmp(type,"UDP") && ip && port && local);
    assert(!strcmp(port,QCAR_WIFI_TARGET_PORT) && !strcmp(local,QCAR_WIFI_LOCAL_PORT));
    ++socket_calls; return fail_stage==3;
}
uint8 wifi_spi_socket_disconnect(void) { assert(!irq_disabled); ++disconnect_calls; return 0; }
uint32 wifi_spi_send_buffer(const uint8 *data,uint32 size) {
    assert(!irq_disabled && size<=sizeof(outgoing));
    if(fail_send) return size;
    memcpy(outgoing,data,size); outgoing_size=size; return 0;
}
uint8 wifi_spi_udp_send_now(void) {
    assert(!irq_disabled && packet_count<128);
    if(fail_flush) return 1;
    memcpy(datagrams[packet_count],outgoing,outgoing_size);
    sizes[packet_count++]=outgoing_size; return 0;
}
uint32 wifi_spi_read_buffer(uint8 *data,uint32 length) {
    size_t count=incoming_size<length?incoming_size:length;
    assert(!irq_disabled); ++rx_calls;
    memcpy(data,incoming,count); memmove(incoming,incoming+count,incoming_size-count);
    incoming_size-=count; return (uint32)count;
}
static void advance(unsigned ms) { ticks+=100000u*ms; wifispi_telemetry_service(); }
static void queue(const void *bytes,size_t size) {
    assert(incoming_size+size<=sizeof(incoming));
    memcpy(incoming+incoming_size,bytes,size); incoming_size+=size;
}
static void command(const char *line) {
    packet_count=0; queue(line,strlen(line));
    do { advance(10); } while(incoming_size);
}
static int has_reply(const char *line) {
    for(size_t i=0;i<packet_count;++i)
        if(sizes[i]==strlen(line) && !memcmp(datagrams[i],line,sizes[i])) return 1;
    return 0;
}
static float last_value(unsigned channel,unsigned count) {
    float value; size_t i=packet_count-1;
    assert(sizes[i]==VOFA_FRAME_BYTES(count));
    assert(!memcmp(datagrams[i]+4*count,"\0\0\x80\x7f",4));
    memcpy(&value,datagrams[i]+4*channel,4); return value;
}
static void cancel_during_join(void) { if (imu_wifi_status==3) wifispi_cancel_init(); }
static void test_transport(void)
{
    /* No SPI before the explicit connection request. */
    advance(100); assert(init_calls==0 && rx_calls==0 && packet_count==0);
    assert(!wifispi_send_floats((float[]){1},1));
    wifispi_telemetry_init();
    assert(wifispi_is_ready() && imu_wifi_status==1 && init_calls==1);
    assert(wifi_telemetry_channel_count==3 && wifi_telemetry_period_ms==10);
    wifispi_telemetry_announce();
    assert(has_reply("MCAR SUB roll_deg,pitch_deg,yaw_deg\n"));
    assert(has_reply("MCAR RATE 10\n") && has_reply("MCAR STREAM 1\n"));
    packet_count=0;

    advance(9); assert(packet_count==0 && rx_calls==0);
    advance(1); assert(last_value(0,3)==12 && last_value(2,3)==30);
    if (getenv("QCAR_WIFI_IMU_FIXTURE")) {
        FILE *file=fopen(getenv("QCAR_WIFI_IMU_FIXTURE"),"wb"); assert(file);
        assert(fwrite(datagrams[packet_count-1],1,sizes[packet_count-1],file)==16);
        assert(fclose(file)==0);
    }

    command(" SUB imu_cal_percent,gyro_z_dps,imu_seq,ekf_nis \r\n");
    assert(has_reply("MCAR SUB imu_cal_percent,gyro_z_dps,imu_seq,ekf_nis\n"));
    assert(last_value(0,4)==100 && last_value(1,4)==3 && last_value(2,4)==1234);
    const char *bad[]={"SUB imu_cal_percent,bad\n", "SUB imu_cal_percent,imu_cal_percent\n", "SUB imu_cal_percent,\n", "SUB \n"};
    for(unsigned i=0;i<sizeof(bad)/sizeof(bad[0]);++i) {
        command(bad[i]); assert(wifi_telemetry_channel_count==4 && last_value(0,4)==100);
    }
    command("RATE 0\nRATE -1\nRATE 1001\nRATE 2x\nRATE 99999999999999999999999\n");
    assert(wifi_telemetry_period_ms==10);
    command("STREAM 0\n"); assert(!wifi_telemetry_stream_enabled && has_reply("MCAR STREAM 0\n"));
    command("GET?\nLIST?\nRATE 1000\n");
    assert(has_reply("MCAR RATE 10\n") && has_reply("MCAR STREAM 0\n"));
    assert(has_reply("MCAR RATE 1000\n") && rx_calls>0);
    command("STREAM 1\nRATE 2\n"); assert(wifi_telemetry_stream_enabled && wifi_telemetry_period_ms==2);
    command("[slider,ground_angle_kp,2.5]");
    assert(ground_angle_kp==2.5f && has_reply("MCAR SLIDER ground_angle_kp 2.5\n"));
    command("[\"slider\",\"balance_angle_x\",-1.25e1]\n");
    assert(mono_params.balance_angle_x==-12.5f);
    command("[slider,ground_angle_kp,");
    command("3.0][slider,pitch_balance_kp,0.5]RATE 20\n");
    assert(ground_angle_kp==3 && pitch_balance_kp==0.5f && wifi_telemetry_period_ms==20);
    command("[slider,debug_fly_left_pwm,300][slider,debug_fly_right_pwm,-700][slider,debug_ground_pwm,-500]");
    assert(pwm_debug_fly_left==300 && pwm_debug_fly_right==-700 && pwm_debug_ground==-500);
    command("[slider,debug_fly_left_pwm,4001][slider,debug_fly_right_pwm,NaN][slider,debug_ground_pwm,NaN]");
    assert(pwm_debug_fly_left==300 && pwm_debug_fly_right==-700 && pwm_debug_ground==-500);
    command("[slider,debug_fly_pwm,900]"); /* Retired paired command must not move either side. */
    assert(pwm_debug_fly_left==300 && pwm_debug_fly_right==-700);
    const char *bad_slider[]={
        "[slider,ground_angle_kp,NaN]", "[slider,ground_angle_kp,1e100]",
        "[slider,ground_angle_kp,0x1p0]", "[slider,ground_angle_kp,1,2]",
        "[slider,ground_angle_kp,-1]", "[slider,ground_angle_kp,1001]",
        "[slider,run,1]", "[slider,balance_angle_x,46]", "GOTO 1 20 20 0\n", "STOP 2\n",
        "[slider,ground_angle_kp,[slider,ground_angle_kp,9]]\n"
    };
    for(unsigned i=0;i<sizeof(bad_slider)/sizeof(bad_slider[0]);++i) {
        uint32 errors=wifi_telemetry_command_errors;
        command(bad_slider[i]);
        assert(wifi_telemetry_command_errors>errors && ground_angle_kp==3);
        assert(mono_params.balance_angle_x==-12.5f);
    }
    char huge[1100]; memset(huge,'x',sizeof(huge)); queue(huge,sizeof(huge));
    command("\nSUB roll_deg,pitch_deg,yaw_deg\n");
    assert(has_reply("MCAR ERR invalid or oversized line\n") && wifi_telemetry_channel_count==3);
    command("[slider,ground_angle_kp,");
    const char binary[]={0,'7',']'}; queue(binary,sizeof(binary)); command("\n");
    assert(ground_angle_kp==3 && has_reply("MCAR ERR invalid or oversized line\n"));
    command("RATE 10\n"); packet_count=0;
    pwm_debug_enabled=1;
    command("SUB pwm_debug_enabled,debug_fly_left_pwm,debug_fly_right_pwm,debug_ground_pwm\n");
    assert(last_value(0,4)==1 && last_value(1,4)==300 && last_value(2,4)==-700 && last_value(3,4)==-500);
    pwm_debug_enabled=0;
    command("SUB roll_deg,pitch_deg,yaw_deg\n");
    packet_count=0;
    ticks=UINT32_MAX-500000u; wifispi_telemetry_service(); packet_count=0;
    advance(10); assert(last_value(0,3)==12); /* STM wrap-around. */
    uint32 sent=imu_wifi_tx_packets;
    fail_send=1; assert(!wifi_justfloat(1,2,3) && imu_wifi_status==-4 && imu_wifi_tx_packets==sent);
    fail_send=0; fail_flush=1; assert(!wifi_justfloat(1) && imu_wifi_tx_packets==sent);
    fail_flush=0; assert(wifi_justfloat(1,2,3) && imu_wifi_status==1 && imu_wifi_tx_packets==sent+1);
    wifispi_telemetry_stop();
    assert(!wifispi_is_ready() && imu_wifi_status==0 && disconnect_calls==1);
    packet_count=0; unsigned old_rx=rx_calls; advance(1000);
    assert(packet_count==0 && rx_calls==old_rx);
    fail_attempts=2; wifispi_telemetry_init();
    assert(wifispi_is_ready() && imu_wifi_init_attempts==3 && imu_wifi_last_error==-1);
    for(unsigned stage=1;stage<=4;++stage) {
        fail_stage=stage; wifispi_telemetry_init();
        assert(!wifispi_is_ready() && imu_wifi_init_attempts==QCAR_WIFI_INIT_ATTEMPTS);
        assert(imu_wifi_status==-(stage==4?1:(int)stage));
        assert(imu_wifi_module_result==(stage==1?1:0));
    }
    fail_stage=0; wifispi_telemetry_init();
    assert(wifispi_is_ready() && wifi_telemetry_channel_count==3 && wifi_telemetry_period_ms==10);
    assert(connect_calls>0 && socket_calls>0 && !irq_disabled);
    motor_value.receive_left_speed_data=234; motor_value.receive_right_speed_data=-234;
    command("SUB telemetry_ms,rate_seq,rate_target_dps,rate_actual_dps,rate_error_dps,rate_pwm,motor_left_pwm,motor_right_pwm,roll_deg,pitch_deg,rate_state,imu_status,rate_kp,rate_sign,rate_pwm_limit,flywheel_left_speed_raw,flywheel_right_speed_raw,driver_speed_frames,imu_seq\n");
    assert(wifi_telemetry_channel_count==19);
    assert(last_value(1,19)==99 && last_value(3,19)==-12.5f && last_value(4,19)==12.5f);
    assert(last_value(5,19)==250 && last_value(6,19)==-250 && last_value(7,19)==250);
    assert(last_value(10,19)==2 && last_value(12,19)==20 && last_value(13,19)==1);
    assert(last_value(14,19)==1000 && last_value(15,19)==234 && last_value(16,19)==-234);
    assert(last_value(17,19)==123 && last_value(18,19)==1234);
    if (getenv("QCAR_WIFI_FIXTURE")) {
        FILE *file=fopen(getenv("QCAR_WIFI_FIXTURE"),"wb"); assert(file);
        assert(fwrite(datagrams[packet_count-1],1,sizes[packet_count-1],file)==80);
        assert(fclose(file)==0);
    }
    pitch_balance_actual_angle=1.7f;pitch_balance_target_angle=-0.3f;pitch_balance_error=-2;
    pitch_balance_kp=36.5f;pitch_balance_rate_limit=40;pitch_balance_target_rate=-40;
    roll_rate_test_actual=0;roll_rate_test_error=-40;roll_rate_test_pwm=-1000;
    roll_rate_test_kp=25;roll_rate_test_sign=1;roll_rate_test_limit=3000;
    costrained_flywheel_speed_left=costrained_flywheel_speed_right=-1000;
    wifispi_telemetry_angle_profile();
    command("SUB telemetry_ms,rate_seq,imu_seq,imu_status,rate_state,rate_enabled,balance_target_deg,balance_actual_deg,balance_error_deg,rate_target_dps,rate_actual_dps,rate_error_dps,rate_pwm,motor_left_pwm,motor_right_pwm,balance_kp,rate_kp,rate_sign,balance_rate_limit_dps,rate_pwm_limit,balance_rate_saturated,balance_pwm_saturated,flywheel_left_speed_raw,flywheel_right_speed_raw,driver_speed_frames,imu_dt_ms,roll_deg,pitch_deg\n");
    assert(wifi_telemetry_channel_count==28);
    assert(last_value(7,28)==1.7f && last_value(8,28)==-2 && last_value(9,28)==-40);
    assert(last_value(12,28)==-1000 && last_value(13,28)==1000 && last_value(14,28)==-1000);
    assert(last_value(20,28)==1 && last_value(21,28)==0);
    if (getenv("QCAR_WIFI_ANGLE_FIXTURE")) {
        FILE *file=fopen(getenv("QCAR_WIFI_ANGLE_FIXTURE"),"wb");assert(file);
        assert(fwrite(datagrams[packet_count-1],1,sizes[packet_count-1],file)==116);assert(fclose(file)==0);
    }
    pitch_balance_target_rate=0;ground_angle_kp=0;
    ground_rate_test_enabled=1;ground_rate_test_kp=25;ground_rate_test_limit=1000;ground_rate_test_sign=-1;
    costrained_wheel_speed=321;roll_rate_test_pwm=1000;
    command("SUB rate_axis,motor_ground_pwm,rate_kp,rate_sign,rate_pwm_limit,balance_kp,balance_rate_limit_dps,balance_rate_saturated,balance_pwm_saturated\n");
    advance(20);
    assert(last_value(0,9)==1 && last_value(1,9)==321 && last_value(2,9)==25);
    assert(last_value(3,9)==-1 && last_value(4,9)==1000 && last_value(5,9)==0);
    assert(last_value(6,9)==10 && last_value(7,9)==0 && last_value(8,9)==1);
    ground_angle_kp=2.5f;pitch_balance_target_rate=10;advance(20);
    assert(last_value(5,9)==2.5f && last_value(7,9)==1);
    ground_rate_test_enabled=0;
    dual_balance_enabled=ground_rate_test_enabled=1;
    dual_angle[0]=1.7f;dual_target[0]=-.3f;dual_angle_error[0]=-2;
    dual_target_rate[0]=-80;dual_rate[0]=0;dual_rate_error[0]=-80;dual_pwm[0]=-2800;
    dual_angle[1]=3.9f;dual_target[1]=.9f;dual_angle_error[1]=-3;
    dual_target_rate[1]=-30;dual_rate[1]=0;dual_rate_error[1]=-30;dual_pwm[1]=-3000;
    pitch_balance_kp=50;pitch_balance_rate_limit=80;roll_rate_test_kp=35;roll_rate_test_sign=1;roll_rate_test_limit=4000;
    ground_angle_kp=10;ground_angle_rate_limit=30;ground_rate_test_kp=100;ground_rate_test_sign=1;ground_rate_test_limit=4000;
    costrained_flywheel_speed_left=costrained_flywheel_speed_right=-2800;costrained_wheel_speed=-3000;
    wifispi_telemetry_dual_profile();packet_count=0;advance(20);
    assert(wifi_telemetry_channel_count==45 && sizes[packet_count-1]==184);
    assert(last_value(6,45)==1.7f && last_value(12,45)==-2800);
    assert(last_value(13,45)==3.9f && last_value(19,45)==-3000);
    assert(last_value(30,45)==2800 && last_value(31,45)==-2800 && last_value(32,45)==-3000);
    assert(last_value(34,45)==0 && last_value(35,45)==0 && last_value(36,45)==0 && last_value(39,45)==1);
    assert(last_value(40,45)==234 && last_value(41,45)==-234 && last_value(42,45)==123);
    assert(last_value(43,45)==12 && last_value(44,45)==1);
    if (getenv("QCAR_WIFI_DUAL_FIXTURE")) {
        FILE *file=fopen(getenv("QCAR_WIFI_DUAL_FIXTURE"),"wb");assert(file);
        assert(fwrite(datagrams[packet_count-1],1,sizes[packet_count-1],file)==184);assert(fclose(file)==0);
    }
    dual_balance_enabled=ground_rate_test_enabled=0;
    roll_rate_test_state=-1;rate_only_test=1;control_fault_reason=4;control_fault_imu_status=1;
    control_fault_seq=1234;control_fault_dt_ms=15;control_startup_scale=.25f;
    imu_spi_timeouts=2;imu_not_ready_samples=9;imu_last_status_reg=3;
    wifispi_telemetry_startup_profile();packet_count=0;advance(20);
    assert(wifi_telemetry_channel_count==39);
    assert(last_value(34,39)==234 && last_value(35,39)==-234 && last_value(36,39)==123);
    assert(last_value(37,39)==12 && last_value(38,39)==1);
    assert(last_value(27,39)==4);
    assert(last_value(28,39)==1);
    assert(last_value(29,39)==1234);
    assert(last_value(30,39)==15);
    assert(last_value(31,39)==2);
    assert(last_value(32,39)==9);
    assert(last_value(33,39)==3);
    if (getenv("QCAR_WIFI_STARTUP_FIXTURE")) {
        FILE *file=fopen(getenv("QCAR_WIFI_STARTUP_FIXTURE"),"wb");assert(file);
        assert(fwrite(datagrams[packet_count-1],1,sizes[packet_count-1],file)==160);assert(fclose(file)==0);
    }
    unsigned previous_sockets=socket_calls;
    wifispi_set_progress_hook(cancel_during_join);
    wifispi_telemetry_init();
    assert(!wifispi_is_ready() && imu_wifi_status==-6 && imu_wifi_init_attempts==1);
    assert(socket_calls==previous_sockets && active_wait_callback==NULL);
    wifispi_set_progress_hook(NULL);
    wifispi_telemetry_init(); assert(wifispi_is_ready() && active_wait_callback==NULL);
    puts("PASS: UDP frames, subscription, sliders, malformed input, IRQ boundaries, STM wrap, retries and stop");
}
#endif

int main(void)
{
    test_pack();
#if QCAR_WIFI_ENABLED
    test_transport();
#else
    wifispi_telemetry_init();
    assert(imu_wifi_status==-5 && !wifispi_is_ready());
    wifispi_telemetry_service();
    assert(!wifi_justfloat(1,2,3));
    wifispi_telemetry_stop();
    puts("PASS: disabled build links with no SPI/STM/IMU/control hardware symbols; JustFloat packing");
#endif
}
