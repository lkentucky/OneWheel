#include "imu.h"
#include "imu_config.h"
#include "attitude_algorithm.h"
#include "zf_device_imu660rb.h"
#include <assert.h>
#include <math.h>
#include <stdio.h>
#include <string.h>
int host_stm;
static uint32 ticks;
static uint8 registers[128],ready=3,cs=1,init_result;
static int irq;
static int16 raw_a[3]={4098,0,0},raw_g[3]={14,-28,42};
int16 imu660rb_acc_x,imu660rb_acc_y,imu660rb_acc_z;
int16 imu660rb_gyro_x,imu660rb_gyro_y,imu660rb_gyro_z;
float imu660rb_transition_factor[2]={4098,14.3f};
uint32 IfxStm_getLower(int *s) {(void)s; return ticks;}
float IfxStm_getFrequency(int *s) {(void)s; return 100000000.0f;}
uint8 imu660rb_init(void) {registers[0x12]=0x44; return init_result;}
void gpio_high(int p) {assert(p==13 && !cs);cs=1;}
void gpio_low(int p) {assert(p==13 && cs);cs=0;}
void system_delay_ms(uint32 ms) {ticks+=100000u*ms;}
uint32 interrupt_global_disable(void) {assert(!irq);irq=1;return 0;}
void interrupt_global_enable(uint32 p) {assert(irq && !p);irq=0;}
void spi_write_8bit_register(int s,uint8 r,uint8 v) {assert(s==0 && !cs && r<128);registers[r]=v;}
uint8 spi_read_8bit_register(int s,uint8 r) {assert(s==0 && !cs && (r&128));r&=127;return r==0x1e?ready:registers[r];}
void spi_read_8bit_registers(int s,uint8 r,uint8 *out,uint32 n) {
    assert(s==0 && !cs && r==0xa2 && n==12);
    for(unsigned i=0;i<3;++i) {
        out[2*i]=(uint8)raw_g[i];out[2*i+1]=(uint8)((uint16)raw_g[i]>>8);
        out[6+2*i]=(uint8)raw_a[i];out[7+2*i]=(uint8)((uint16)raw_a[i]>>8);
    }
}
static void tick(void) {ticks+=500000u;imu_update_5ms();assert(cs);}
static void calibrate(void) {
    assert(imu_attitude_status==IMU_ATTITUDE_CALIBRATING);
    for(unsigned i=0;i<CALIBRATION_SAMPLES+1 && imu_attitude_status==IMU_ATTITUDE_CALIBRATING;++i) tick();
    assert(imu_attitude_status==IMU_ATTITUDE_RUNNING);
}
int main(void) {
    imu_navigation_sample_t frame;
    ticks=0xfff00000u; /* STM rollover during calibration. */
    imu_init();
    assert(registers[0x10]==0x6c && registers[0x11]==0x6c);
    /* Moving calibration samples cannot arm control. */
    raw_g[1]=1000;for(unsigned i=0;i<10;++i) tick();
    assert(imu_attitude_status==0 && imu_calibration_percent==0);
    raw_g[1]=-28;calibrate();
    assert(imu_get_navigation_sample(&frame) && frame.sequence==1);
    assert(frame.accel_g[2]==1 && frame.accel_g[0]==0);
    assert(fabsf(imu_gyro_dps[0]-42/14.3f)<1e-5f);
    assert(fabsf(imu_gyro_dps[1]-28/14.3f)<1e-5f);
    assert(fabsf(mahony_filter.gyro.z)<1e-5f);
    assert(fabsf(mahony_filter.acc.z-9.80665f)<1e-5f);
    raw_g[0]+=143;tick();
    assert(imu_get_navigation_sample(&frame) && frame.sequence==2);
    assert(fabsf(frame.gyro_dps[2]-10)<1e-4f);
    assert(fabsf(mahony_filter.gyro.z-10)<1e-4f);
    assert(imu_yaw_deg>0 && fabsf(imu_gyro_z_integral_deg-.05f)<1e-5f);
    assert(fabsf(imu_sample_dt_ms-5)<1e-5f);
    raw_a[0]=8196;tick();assert(imu_accel_used==0);raw_a[0]=4098;
    ready=1;tick();assert(imu_sample_sequence==3); /* both DRDY required */
    for(unsigned i=0;i<21;++i) tick();
    assert(imu_attitude_status==IMU_ATTITUDE_TIMEOUT && !imu_get_navigation_sample(&frame));
    ready=3;raw_g[0]=14;imu_request_recalibration();imu_service();calibrate();
    ticks+=5000000;tick();assert(imu_attitude_status==IMU_ATTITUDE_BAD_DT);
    imu_recover_after_stall();tick();tick();assert(imu_attitude_status==IMU_ATTITUDE_RUNNING);
    /* Unwrapped yaw must cross +/-180 without a 360-degree discontinuity. */
    raw_g[0]+=1430;
    for(unsigned i=0;i<800;++i) tick();
    assert(fabsf(mahony_filter.True_yaw-400)<.1f);
    /* Check side-tilt rate feeds roll and fore/aft rate feeds pitch. */
    raw_g[0]=14;raw_g[1]=-28;raw_g[2]=42;
    imu_request_recalibration();imu_service();calibrate();
    raw_g[2]+=143;tick();assert(imu_get_navigation_sample(&frame));
    assert(fabsf(frame.gyro_dps[0]-10)<1e-4f && fabsf(frame.gyro_dps[1])<1e-4f);
    assert(imu_roll_deg>0);
    raw_g[2]=42;raw_g[1]-=143;tick();assert(imu_get_navigation_sample(&frame));
    assert(fabsf(frame.gyro_dps[1]-10)<1e-4f && fabsf(frame.gyro_dps[0])<1e-4f);
    assert(imu_pitch_deg>0);
    init_result=1;imu_init();assert(imu_attitude_status==IMU_ATTITUDE_INIT_FAILED);
    printf("RB pipeline method %u: burst/mapping/scaling, calibration, dt rollover, gating, timeout/recovery, yaw passed\n",imu_attitude_method);
}
