#include "pid.h"

#include <assert.h>
#include <float.h>

static int nearf(float a, float b, float tol)
{
    float d = a - b;
    if (d < 0.0f) {
        d = -d;
    }
    return d <= tol;
}

static void test_p_only_exact(void)
{
    pid_controller_t pid = {0};
    float out;

    pid.kp = 2.0f;
    pid.ki = 0.0f;
    pid.kd = 0.0f;
    pid.integral_limit = 100.0f;
    pid.output_min = -100.0f;
    pid.output_max = 100.0f;
    pid_reset(&pid);

    out = pid_position_update(&pid, 10.0f, 4.0f, 0.1f);
    assert(out == 12.0f);
    out = pid_position_update(&pid, 20.0f, 4.0f, 0.1f);
    assert(out == 32.0f);

    /* Saturation is exactly the clamped P term. */
    out = pid_position_update(&pid, 100.0f, 0.0f, 0.1f);
    assert(out == 100.0f);
    assert(pid.integral == 0.0f);
}

static void test_pi(void)
{
    pid_controller_t pid = {0};

    pid.kp = 1.0f;
    pid.ki = 2.0f;
    pid.kd = 0.0f;
    pid.integral_limit = 1000.0f;
    pid.output_min = -1000.0f;
    pid.output_max = 1000.0f;
    pid_reset(&pid);

    assert(nearf(pid_position_update(&pid, 10.0f, 0.0f, 0.5f), 20.0f, 1e-5f));
    assert(nearf(pid.integral, 10.0f, 1e-5f));
    assert(nearf(pid_position_update(&pid, 10.0f, 0.0f, 0.5f), 30.0f, 1e-5f));
    assert(nearf(pid.integral, 20.0f, 1e-5f));
}

static void test_derivative_first_sample(void)
{
    pid_controller_t pid = {0};

    pid.kp = 0.0f;
    pid.ki = 0.0f;
    pid.kd = 5.0f;
    pid.integral_limit = 1000.0f;
    pid.output_min = -1000.0f;
    pid.output_max = 1000.0f;
    pid_reset(&pid);

    /* First sample has no derivative. */
    assert(pid_position_update(&pid, 10.0f, 0.0f, 0.1f) == 0.0f);
    /* Then d/dt(12 - 10) = 20, times Kd = 100. */
    assert(nearf(pid_position_update(&pid, 12.0f, 0.0f, 0.1f), 100.0f, 1e-4f));
    /* Same error again: derivative is zero. */
    assert(nearf(pid_position_update(&pid, 12.0f, 0.0f, 0.1f), 0.0f, 1e-4f));
}

static void test_position_incremental_equivalence(void)
{
    pid_controller_t pos = {0};
    pid_controller_t inc = {0};
    float targets[4] = {10.0f, 12.0f, 9.0f, 15.0f};
    float measured[4] = {2.0f, 3.0f, 5.0f, 7.0f};
    int i;

    pos.kp = inc.kp = 1.5f;
    pos.ki = inc.ki = 0.7f;
    pos.kd = inc.kd = 0.2f;
    pos.integral_limit = inc.integral_limit = 1000.0f;
    pos.output_min = inc.output_min = -1000.0f;
    pos.output_max = inc.output_max = 1000.0f;
    pid_reset(&pos);
    pid_reset(&inc);

    for (i = 0; i < 4; ++i) {
        float a = pid_position_update(&pos, targets[i], measured[i], 0.1f);
        float b = pid_incremental_update(&inc, targets[i], measured[i], 0.1f);
        assert(nearf(a, b, 1e-3f));
        assert(nearf(pos.integral, inc.integral, 1e-4f));
    }
}

static void test_incremental_first_derivative(void)
{
    pid_controller_t pid = {0};

    pid.kp = 0.0f;
    pid.ki = 0.0f;
    pid.kd = 5.0f;
    pid.integral_limit = 1000.0f;
    pid.output_min = -1000.0f;
    pid.output_max = 1000.0f;
    pid_reset(&pid);

    assert(pid_incremental_update(&pid, 10.0f, 0.0f, 0.1f) == 0.0f);
    assert(nearf(pid_incremental_update(&pid, 12.0f, 0.0f, 0.1f), 100.0f, 1e-4f));
    assert(nearf(pid_incremental_update(&pid, 12.0f, 0.0f, 0.1f), 0.0f, 1e-4f));
}

static void test_limits(void)
{
    pid_controller_t pid = {0};
    float out;

    pid.kp = 10.0f;
    pid.ki = 0.0f;
    pid.kd = 0.0f;
    pid.integral_limit = 1000.0f;
    pid.output_min = -5.0f;
    pid.output_max = 5.0f;
    pid_reset(&pid);

    assert(pid_position_update(&pid, 10.0f, 0.0f, 0.1f) == 5.0f);
    assert(pid_position_update(&pid, -10.0f, 0.0f, 0.1f) == -5.0f);
    assert(pid_position_update(&pid, 0.0f, 0.0f, 0.1f) == 0.0f);

    /* Integral clamp on its own (unsaturated output). */
    pid.kp = 0.0f;
    pid.ki = 1.0f;
    pid.integral_limit = 3.0f;
    pid.output_min = -100.0f;
    pid.output_max = 100.0f;
    pid_reset(&pid);
    out = pid_position_update(&pid, 10.0f, 0.0f, 1.0f);
    assert(nearf(out, 3.0f, 1e-5f));
    assert(nearf(pid.integral, 3.0f, 1e-5f));
    out = pid_position_update(&pid, 10.0f, 0.0f, 1.0f);
    assert(nearf(out, 3.0f, 1e-5f));
    assert(nearf(pid.integral, 3.0f, 1e-5f));
}

static void test_antiwindup_recovery(void)
{
    pid_controller_t pid = {0};
    int i;

    pid.kp = 1.0f;
    pid.ki = 10.0f;
    pid.kd = 0.0f;
    pid.integral_limit = 100.0f;
    pid.output_min = -5.0f;
    pid.output_max = 5.0f;
    pid_reset(&pid);

    /* Push into the positive limit repeatedly; integral must not wind up. */
    for (i = 0; i < 20; ++i) {
        assert(pid_position_update(&pid, 10.0f, 0.0f, 0.1f) == 5.0f);
    }
    assert(pid.integral == 0.0f);

    /* Error goes to zero: output leaves saturation immediately. */
    assert(pid_position_update(&pid, 0.0f, 0.0f, 0.1f) == 0.0f);
    assert(pid.integral == 0.0f);
}

static void test_incremental_accumulates_clamped_output(void)
{
    pid_controller_t pid = {0};
    float out;

    pid.kp = 1.0f;
    pid.ki = 0.0f;
    pid.kd = 0.0f;
    pid.integral_limit = 100.0f;
    pid.output_min = -5.0f;
    pid.output_max = 5.0f;
    pid_reset(&pid);

    out = pid_incremental_update(&pid, 10.0f, 0.0f, 0.1f);
    assert(out == 5.0f);
    /* Previous output was clamped to 5, so a -5 increment lands at 0. */
    out = pid_incremental_update(&pid, 5.0f, 0.0f, 0.1f);
    assert(nearf(out, 0.0f, 1e-5f));
    out = pid_incremental_update(&pid, 10.0f, 0.0f, 0.1f);
    assert(out == 5.0f);
}

static void test_reset(void)
{
    pid_controller_t pid = {0};

    pid.kp = 1.0f;
    pid.ki = 2.0f;
    pid.kd = 3.0f;
    pid.integral_limit = 100.0f;
    pid.output_min = -100.0f;
    pid.output_max = 100.0f;
    pid_reset(&pid);

    (void)pid_position_update(&pid, 10.0f, 0.0f, 0.1f);
    assert(pid.integral != 0.0f);
    assert(pid.initialized != 0);

    pid_reset(&pid);
    assert(pid.integral == 0.0f);
    assert(pid.error_1 == 0.0f);
    assert(pid.error_2 == 0.0f);
    assert(pid.output == 0.0f);
    assert(pid.initialized == 0);
    /* Configuration retained. */
    assert(pid.kp == 1.0f && pid.ki == 2.0f && pid.kd == 3.0f);
    assert(pid.integral_limit == 100.0f);
    assert(pid.output_min == -100.0f && pid.output_max == 100.0f);

    /* Derivative is zero again on the first sample after reset. */
    assert(pid_position_update(&pid, 10.0f, 0.0f, 0.1f) == 12.0f);
}

static void test_independent_instances(void)
{
    pid_controller_t a = {0};
    pid_controller_t b = {0};

    a.kp = 1.0f;
    b.kp = 2.0f;
    a.ki = b.ki = 0.0f;
    a.kd = b.kd = 0.0f;
    a.integral_limit = b.integral_limit = 100.0f;
    a.output_min = b.output_min = -100.0f;
    a.output_max = b.output_max = 100.0f;
    pid_reset(&a);
    pid_reset(&b);

    assert(pid_position_update(&a, 10.0f, 0.0f, 0.1f) == 10.0f);
    assert(pid_position_update(&b, 10.0f, 0.0f, 0.1f) == 20.0f);
    assert(pid_position_update(&a, 0.0f, 0.0f, 0.1f) == 0.0f);
    /* b is unaffected by a's update. */
    assert(b.output == 20.0f);
    assert(pid_position_update(&b, 10.0f, 0.0f, 0.1f) == 20.0f);
}

static void test_invalid_inputs(void)
{
    pid_controller_t pid = {0};
    float zero = 0.0f;
    float nan_value = zero / zero;
    float inf_value = 1.0f / zero;

    pid.kp = 2.0f;
    pid.ki = 3.0f;
    pid.kd = 4.0f;
    pid.integral_limit = 100.0f;
    pid.output_min = -100.0f;
    pid.output_max = 100.0f;
    pid_reset(&pid);

    /* A valid update first, so we can observe the reset. */
    (void)pid_position_update(&pid, 10.0f, 0.0f, 0.1f);
    assert(pid.integral != 0.0f);

    assert(pid_position_update(&pid, nan_value, 0.0f, 0.1f) == 0.0f);
    assert(pid.integral == 0.0f && pid.output == 0.0f);
    assert(pid.initialized == 0 && pid.error_1 == 0.0f && pid.error_2 == 0.0f);
    assert(pid.kp == 2.0f && pid.ki == 3.0f && pid.kd == 4.0f);

    assert(pid_incremental_update(&pid, 0.0f, inf_value, 0.1f) == 0.0f);
    assert(pid.integral == 0.0f && pid.initialized == 0);

    assert(pid_position_update(&pid, 1.0f, 0.0f, 0.0f) == 0.0f);
    assert(pid_position_update(&pid, 1.0f, 0.0f, -0.1f) == 0.0f);
    assert(pid_position_update(&pid, 1.0f, 0.0f, nan_value) == 0.0f);

    /* Invalid configuration: reset state, retain fields. */
    (void)pid_position_update(&pid, 10.0f, 0.0f, 0.1f);
    pid.output_min = 5.0f;
    pid.output_max = -5.0f;
    assert(pid_position_update(&pid, 10.0f, 0.0f, 0.1f) == 0.0f);
    assert(pid.integral == 0.0f && pid.initialized == 0);
    assert(pid.output_min == 5.0f && pid.output_max == -5.0f);
    assert(pid.kp == 2.0f && pid.ki == 3.0f && pid.kd == 4.0f);

    pid.output_min = -100.0f;
    pid.output_max = 100.0f;
    pid.kp = inf_value;
    assert(pid_position_update(&pid, 10.0f, 0.0f, 0.1f) == 0.0f);
    assert(pid.integral == 0.0f && pid.initialized == 0);

    assert(pid_position_update(0, 1.0f, 0.0f, 0.1f) == 0.0f);
    assert(pid_incremental_update(0, 1.0f, 0.0f, 0.1f) == 0.0f);
    pid_reset(0);
}

static void test_variable_dt_and_overflow(void)
{
    pid_controller_t pos={0},inc={0};
    float periods[]={.005f,.01f,.003f,.008f};
    pos.kp=inc.kp=2;pos.ki=inc.ki=.5f;pos.kd=inc.kd=.02f;
    pos.integral_limit=inc.integral_limit=100;
    pos.output_min=inc.output_min=-1000;pos.output_max=inc.output_max=1000;
    for(int i=0;i<4;++i) {
        float a=pid_position_update(&pos,(float)(i+1),.25f,periods[i]);
        float b=pid_incremental_update(&inc,(float)(i+1),.25f,periods[i]);
        assert(nearf(a,b,.0001f));
    }
    pos.kp=FLT_MAX;assert(pid_position_update(&pos,2,0,.005f)==0 && !pos.initialized);
    inc.kp=FLT_MAX;pid_reset(&inc);assert(pid_incremental_update(&inc,2,0,.005f)==0 && !inc.initialized);
    assert(inc.derivative==0);
}

int main(void)
{
    test_p_only_exact();
    test_pi();
    test_derivative_first_sample();
    test_position_incremental_equivalence();
    test_incremental_first_derivative();
    test_limits();
    test_antiwindup_recovery();
    test_incremental_accumulates_clamped_output();
    test_reset();
    test_independent_instances();
    test_invalid_inputs();
    test_variable_dt_and_overflow();
    return 0;
}
