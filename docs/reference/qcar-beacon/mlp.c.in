const float b2_max[H2_SIZE] = {
        -0.013871, 0.001628, -0.015211, 0.129686, 0.137627, -0.010042, 0.214625, -0.016858, 0.201030, -0.005894, 0.027390, 0.153958, 0.069941, -0.102344, 0.026414, 0.156302, 0.191926, 0.193479, -0.112877, 0.175479, 0.161286, 0.075496, 0.223324, 0.020442, 0.221112, 0.001811, 0.339710, 0.122289, -0.101466, 0.049005, -0.036742, 0.021779
};
const float W3_max[OUTPUT_SIZE][H2_SIZE] = {
        {0.256062, 0.264909, 0.232857, -0.141234, -0.334409, 0.235653, -0.251788, -0.105625, -0.285593, -0.313510, -0.133314, -0.273249, 0.397224, 0.129687, -0.237521, -0.286000, 0.267242, -0.333733, 0.151877, 0.132543, 0.276132, -0.305350, -0.301162, 0.269077, -0.317213, 0.289544, 0.609674, 0.657406, -0.073936, -0.394050, -0.142727, 0.225698}
};
const float b3_max[OUTPUT_SIZE] = {
        -0.004359
};
const float MLP_SCALER_MEAN_max[INPUT_SIZE]={
        756.41641494,  96.77828511,  53.98887536 ,  1.17501857 , 98.86033708,174.30492381 , 38.20091809
};
const float MLP_SCALER_SCALE_max[INPUT_SIZE]={
        456.723536 ,47.4731296, 34.9078941, 39.8059204,31.3630006, 81.2282247, 26.6151997
};
void mlp_forward(const float input_raw[INPUT_SIZE],
     float output[OUTPUT_SIZE]) {
    // 归一化处理
    float input[INPUT_SIZE];
    for (int i = 0; i < INPUT_SIZE; ++i) {
        input[i] = (input_raw[i] - MLP_SCALER_MEAN[i]) / MLP_SCALER_SCALE[i];
    }

    // 第一层：INPUT_SIZE → H1_SIZE
    float h1[H1_SIZE];
    for (int i = 0; i < H1_SIZE; ++i) {
        float sum = b1[i];
        for (int j = 0; j < INPUT_SIZE; ++j) {
            sum += W1[i][j] * input[j];
        }
        h1[i] = relu(sum);
    }

    // 第二层：H1_SIZE → H2_SIZE
    float h2[H2_SIZE];
    for (int i = 0; i < H2_SIZE; ++i) {
        float sum = b2[i];
        for (int j = 0; j < H1_SIZE; ++j) {
            sum += W2[i][j] * h1[j];
        }
        h2[i] = relu(sum);
    }

    // 第三层：H2_SIZE → OUTPUT_SIZE
    for (int i = 0; i < OUTPUT_SIZE; ++i) {
        float sum = b3[i];
        for (int j = 0; j < H2_SIZE; ++j) {
            sum += W3[i][j] * h2[j];
        }
        output[i] = sigmoid(sum);
    }
}

void mlp_forward_max(const float input_raw[INPUT_SIZE],
     float output[OUTPUT_SIZE]) {
    // 归一化处理
    float input[INPUT_SIZE];
    for (int i = 0; i < INPUT_SIZE; ++i) {
        input[i] = (input_raw[i] - MLP_SCALER_MEAN_max[i]) / MLP_SCALER_SCALE_max[i];
    }

    // 第一层：INPUT_SIZE → H1_SIZE
    float h1_max[H1_SIZE];
    for (int i = 0; i < H1_SIZE; ++i) {
        float sum = b1_max[i];
        for (int j = 0; j < INPUT_SIZE; ++j) {
            sum += W1_max[i][j] * input[j];
        }
        h1_max[i] = relu(sum);
    }

    // 第二层：H1_SIZE → H2_SIZE
    float h2_max[H2_SIZE];
    for (int i = 0; i < H2_SIZE; ++i) {
        float sum = b2_max[i];
        for (int j = 0; j < H1_SIZE; ++j) {
            sum += W2_max[i][j] * h1_max[j];
        }
        h2_max[i] = relu(sum);
    }

    // 第三层：H2_SIZE → OUTPUT_SIZE
    for (int i = 0; i < OUTPUT_SIZE; ++i) {
        float sum = b3_max[i];
        for (int j = 0; j < H2_SIZE; ++j) {
            sum += W3_max[i][j] * h2_max[j];
        }
        output[i] = sigmoid(sum);
    }
}

