# 默认忽略全部文件
*
# 允许 Git 进入子目录，否则下面的白名单规则不会生效
!*/
# 保留源代码
!*.c
!*.h
!*.py
!*.c.in
# 保留 Markdown 文档
!*.md
# 保留本文件
!.gitignore

# 构建产物与 IDE 状态目录始终忽略
/Debug/
/Release/
/Build/
/.ads/

# Required ADS project/linker metadata and vendor configuration archive
!/.project
!/.cproject
!/*.lsl
!/libraries/zf_device/zf_device_config.a

!/.settings/com.infineon.aurix.buildsystem.prefs
!/.settings/org.eclipse.core.resources.prefs
